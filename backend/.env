# Backend
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=http://localhost:3000

# LLM Configuration
# Options: 'transformers' (local) or 'openrouter' (API)
LLM_PROVIDER=openrouter
MODEL_ID=google/flan-t5-base
MAX_NEW_TOKENS=256

# OpenRouter API (only needed if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
# Other good options:
# - anthropic/claude-3.5-sonnet (best quality, longer context)
# - openai/gpt-4-turbo (very good, 128k context)
# - openai/gpt-3.5-turbo (fast, affordable)
# - meta-llama/llama-3.1-70b-instruct (open source, good quality)

# Retrieval
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_DIR=../knowledge_base
INDEX_PATH=../knowledge_base/embeddings/eitc.faiss

# Logging
LOG_LEVEL=INFO
ENABLE_METRICS=true
